<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/mood_notification_padding">

    <TextView
        android:id="@+id/mood_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="@dimen/mood_notification_title_text_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mood_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mood_notification_title_to_body_gap"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="@dimen/mood_notification_body_text_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mood_notification_body_to_buttons_gap"
        android:orientation="horizontal"
        android:weightSum="5">

        <TextView
            android:id="@+id/mood_rating_1"
            style="@style/MoodEmojiButton" />

        <TextView
            android:id="@+id/mood_rating_2"
            style="@style/MoodEmojiButton" />

        <TextView
            android:id="@+id/mood_rating_3"
            style="@style/MoodEmojiButton" />

        <TextView
            android:id="@+id/mood_rating_4"
            style="@style/MoodEmojiButton" />

        <TextView
            android:id="@+id/mood_rating_5"
            style="@style/MoodEmojiButton" />

    </LinearLayout>

</LinearLayout>
